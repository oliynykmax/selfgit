{
  "name": "selfgit",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "dev:web": "bun scripts/dev.ts",
    "astro:build": "bunx --bun astro build --root astro",
    "astro:check": "astro check --root astro",
    "build": "bun scripts/web.ts",
    "deploy": "bun run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "bun check && bun check -p web",
    "test": "bun run build && bun test --timeout 300000",
    "test:ci": "bun run build && bun test --timeout 120000",
    "ci": "bun run typecheck && bun lint && bun fmt --check && bun run test:ci"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "^2.0.0-beta.87",
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.8",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@effect/platform-bun": "^4.1.5",
    "@effect/platform-node": "^4.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "alchemy": "^2.0.0-beta.87",
    "astro": "^7.4.12",
    "bun-plugin-tailwind": "^0.1.2",
    "effect": "^4.1.5",
    "global-jsdom": "^31.0.0",
    "jsdom": "^31.0.1",
    "scheduler": "^0.28.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@pierre/diffs": "1.6.4",
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.1",
    "react": "^19",
    "react-dom": "^19",
    "sanitize-html": "^2.18.2",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
