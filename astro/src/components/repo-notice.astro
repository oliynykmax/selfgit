---
import type { RepoView } from "../lib/selfgit";
import { repoUrl } from "../lib/selfgit";

interface Props {
  repo: string;
  view: Exclude<RepoView, { kind: "tree" }>;
}

const { repo, view } = Astro.props;
---

<main class="mx-auto max-w-6xl px-4 pt-6 pb-12">
  {
    view.kind === "empty" ? (
      <section class="overflow-hidden rounded-lg border bg-background px-5 py-6">
        <h1 class="text-xl font-semibold">{repo}</h1>
        <h2 class="mt-4 font-semibold">This repository is empty</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Push an existing repository to it:
        </p>
        <pre class="mt-3 overflow-x-auto rounded-md border bg-muted/50 p-3 font-mono text-xs leading-6">{`git remote add origin ${repoUrl(repo)}.git\ngit push -u origin main`}</pre>
      </section>
    ) : (
      <div class="px-4 py-12 text-center">
        <h1 class="font-medium">{view.title}</h1>
        <p class="mt-1 text-sm text-muted-foreground">{view.detail}</p>
        <a href="/" class="mt-4 inline-block text-sm underline">
          All repositories
        </a>
      </div>
    )
  }
</main>
