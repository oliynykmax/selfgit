---
import type { RepoRefs, TreeView } from "../../../src/api-types";
import { renderMarkdown } from "../lib/markdown";
import {
  blobUrl,
  parentPath,
  repoUrl,
  treeUrl,
} from "../lib/selfgit";

interface Props {
  repo: string;
  path: string;
  ref: string;
  refs: RepoRefs;
  tree: TreeView;
  originDuration: number;
}

const { repo, path, ref, refs, tree } = Astro.props;
const currentRef = ref === "HEAD" ? (refs.defaultBranch ?? ref) : ref;
const parent = parentPath(path);
const cloneUrl = `${repoUrl(repo)}.git`;
const commitUrl = (oid: string) => `${repoUrl(repo)}/commit/${oid}`;
const commitsUrl = `${repoUrl(repo)}/commits/${encodeURIComponent(currentRef)}`;
const apiCommitsUrl = `/api/commits/${encodeURIComponent(repo)}?ref=${encodeURIComponent(currentRef)}`;
const readmeHtml = tree.readme
  ? renderMarkdown(tree.readme.text, repo, tree.commit.oid, tree.readme.path)
  : null;

function shortOid(oid: string): string {
  return oid.slice(0, 7);
}

function timeAgo(seconds: number): string {
  const delta = seconds - Math.round(Date.now() / 1000);
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ["year", 365 * 24 * 3600],
    ["month", 30 * 24 * 3600],
    ["week", 7 * 24 * 3600],
    ["day", 24 * 3600],
    ["hour", 3600],
    ["minute", 60],
  ];
  for (const [unit, size] of units)
    if (Math.abs(delta) >= size)
      return new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(
        Math.trunc(delta / size),
        unit,
      );
  return "just now";
}

function fullDate(seconds: number): string {
  return new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(seconds * 1000));
}

const sections = [
  { title: "Branches", items: refs.branches },
  { title: "Tags", items: refs.tags },
].filter((section) => section.items.length > 0);
---

<main class="mx-auto max-w-6xl px-4 pt-6 pb-12">
  <div class="flex items-center gap-2 text-xl">
    <a href="/" class="text-muted-foreground hover:text-foreground">
      git.oliinyk.dev
    </a>
    <span class="text-muted-foreground">/</span>
    <a href={treeUrl(repo)} class="font-semibold">{repo}</a>
  </div>

  <div class="mt-5 border-b">
    <nav aria-label="Repository" class="-mb-px flex gap-1 overflow-x-auto">
      <a
        href={treeUrl(repo)}
        aria-current="page"
        class="flex shrink-0 items-center gap-1.5 rounded-t-md border border-border border-b-background bg-background px-3 py-2 text-sm font-medium text-foreground"
      >
        Code
      </a>
      <a
        href={commitsUrl}
        class="flex shrink-0 items-center gap-1.5 rounded-t-md border border-transparent px-3 py-2 text-sm text-muted-foreground hover:text-foreground"
      >
        Commits
      </a>
      <a
        href={`${repoUrl(repo)}/branches`}
        class="flex shrink-0 items-center gap-1.5 rounded-t-md border border-transparent px-3 py-2 text-sm text-muted-foreground hover:text-foreground"
      >
        Branches
        {refs.branches.length > 0 ? <span class="rounded-full bg-muted px-1.5 text-xs tabular-nums">{refs.branches.length}</span> : null}
      </a>
      <a
        href={`${repoUrl(repo)}/tags`}
        class="flex shrink-0 items-center gap-1.5 rounded-t-md border border-transparent px-3 py-2 text-sm text-muted-foreground hover:text-foreground"
      >
        Tags
        {refs.tags.length > 0 ? <span class="rounded-full bg-muted px-1.5 text-xs tabular-nums">{refs.tags.length}</span> : null}
      </a>
      {repo === "selfgit" ? (
        <a
          href={`${repoUrl(repo)}/actions`}
          class="flex shrink-0 items-center gap-1.5 rounded-t-md border border-transparent px-3 py-2 text-sm text-muted-foreground hover:text-foreground"
        >
          Actions
        </a>
      ) : null}
    </nav>
  </div>

  <div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <details class="relative">
          <summary
            aria-label="Switch branch or tag"
            class="group/button inline-flex h-8 max-w-56 cursor-pointer list-none items-center justify-start gap-1.5 rounded-md border border-border bg-background bg-clip-padding px-2.5 text-sm font-normal outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 shrink-0 text-muted-foreground"><line x1="6" x2="6" y1="3" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="18" cy="6" r="3" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="18" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M18 9a9 9 0 0 1-9 9" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <span class="truncate">{currentRef}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="ml-auto size-4 text-muted-foreground"><path d="m7 15 5 5 5-5M7 9l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="absolute z-20 mt-1 w-72 max-w-[calc(100vw-2rem)] rounded-lg border bg-popover p-1 text-sm shadow-md">
            {refs.branches.length > 0 ? (
              <div>
                <p class="px-2 pt-2 pb-1 text-xs font-medium text-muted-foreground">Branches</p>
                {refs.branches.map((branch) => (
                  <a
                    href={treeUrl(repo, path, branch.name)}
                    class:list={[
                      "flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-muted",
                      branch.name === currentRef && "font-medium",
                    ]}
                  >
                    <span class="min-w-0 flex-1 truncate">{branch.name}</span>
                    {branch.name === refs.defaultBranch ? <span class="text-xs text-muted-foreground">default</span> : null}
                  </a>
                ))}
              </div>
            ) : null}
            {refs.tags.length > 0 ? (
              <div>
                <p class="px-2 pt-2 pb-1 text-xs font-medium text-muted-foreground">Tags</p>
                {refs.tags.map((tag) => (
                  <a
                    href={treeUrl(repo, path, tag.name)}
                    class:list={[
                      "flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-muted",
                      tag.name === currentRef && "font-medium",
                    ]}
                  >
                    <span class="min-w-0 flex-1 truncate">{tag.name}</span>
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        </details>
        {path ? (
          <nav aria-label="Path" class="flex min-w-0 flex-wrap items-center gap-1 text-sm">
            <a href={treeUrl(repo, "", currentRef)} class="font-medium hover:underline">{repo}</a>
            {path.split("/").filter(Boolean).map((part, index, parts) => {
              const sub = parts.slice(0, index + 1).join("/");
              const last = index === parts.length - 1;
              return (
                <span class="flex items-center gap-1">
                  <span class="text-muted-foreground">/</span>
                  {last ? <span class="font-medium break-all">{part}</span> : <a href={treeUrl(repo, sub, currentRef)} class="break-all hover:underline">{part}</a>}
                </span>
              );
            })}
          </nav>
        ) : null}
        <div class="ml-auto flex items-center gap-2">
          <a
            href={`${repoUrl(repo)}/commits/${encodeURIComponent(currentRef)}${path ? `/${path.split("/").map(encodeURIComponent).join("/")}` : ""}`}
            aria-label="History"
            class="group/button inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-md border border-transparent bg-clip-padding px-2.5 text-sm font-medium outline-none transition-colors hover:bg-muted hover:text-foreground"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4"><path d="M3 12a9 9 0 1 0 3-6.7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 4v5h5M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="hidden sm:inline">History</span>
          </a>
          {path ? null : (
            <details class="relative">
              <summary class="group/button inline-flex h-8 cursor-pointer list-none items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary bg-clip-padding px-2.5 text-sm font-medium text-primary-foreground outline-none transition-colors hover:bg-primary/85 [&::-webkit-details-marker]:hidden">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Clone
              </summary>
              <div class="absolute right-0 z-20 mt-1 w-[min(26rem,calc(100vw-2rem))] rounded-lg border bg-popover p-3 shadow-md">
                <p class="text-sm font-medium">Clone over HTTPS</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Anyone can clone and fetch. Pushing needs the owner’s GitHub token.</p>
                <code class="mt-3 block truncate rounded-md border bg-muted/50 px-2 py-1.5 font-mono text-xs">{cloneUrl}</code>
              </div>
            </details>
          )}
        </div>
      </div>

      <section class="overflow-hidden rounded-lg border bg-background" aria-label="Files">
        <div class="flex items-center gap-3 border-b bg-muted/40 px-4 py-2.5 text-sm">
          <span class="font-medium">{tree.commit.author.name}</span>
          <a href={commitUrl(tree.commit.oid)} class="min-w-0 flex-1 truncate text-muted-foreground hover:text-foreground hover:underline">{tree.commit.subject}</a>
          <a href={commitUrl(tree.commit.oid)} class="hidden font-mono text-xs text-muted-foreground hover:underline sm:inline">{shortOid(tree.commit.oid)}</a>
          <time class="shrink-0 text-xs text-muted-foreground" datetime={new Date(tree.commit.committer.time * 1000).toISOString()} title={fullDate(tree.commit.committer.time)}>{timeAgo(tree.commit.committer.time)}</time>
        </div>
        <ul class="divide-y text-sm">
          {path ? (
            <li>
              <a href={treeUrl(repo, parent, currentRef)} aria-label="Parent directory" class="flex items-center gap-3 px-4 py-2 text-muted-foreground hover:bg-muted/50">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                ..
              </a>
            </li>
          ) : null}
          {tree.entries.map((entry) => {
            const folder = entry.kind === "tree";
            const submodule = entry.kind === "submodule";
            const href = folder
              ? treeUrl(repo, entry.path, currentRef)
              : submodule
                ? null
                : blobUrl(repo, tree.commit.oid, entry.path);
            return (
              <li class="flex items-center gap-3 px-4 py-2 hover:bg-muted/40">
                {folder ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 shrink-0 fill-muted-foreground/25 text-muted-foreground"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" fill="currentColor" fill-opacity=".25" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                ) : entry.kind === "symlink" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 shrink-0 text-muted-foreground"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 shrink-0 text-muted-foreground"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                )}
                {href ? (
                  <a href={href} class="min-w-0 truncate hover:underline sm:w-56 sm:shrink-0 md:w-64">{entry.name}</a>
                ) : (
                  <span class="min-w-0 truncate sm:w-56 sm:shrink-0 md:w-64" title={`Submodule at ${entry.oid}`}>{entry.name} <span class="font-mono text-xs text-muted-foreground">@ {shortOid(entry.oid)}</span></span>
                )}
                {entry.lastCommit ? (
                  <>
                    <a href={commitUrl(entry.lastCommit.oid)} class="hidden min-w-0 flex-1 truncate text-muted-foreground hover:text-foreground hover:underline sm:block">{entry.lastCommit.subject}</a>
                    <time class="ml-auto shrink-0 text-xs text-muted-foreground sm:ml-0" datetime={new Date(entry.lastCommit.committer.time * 1000).toISOString()} title={fullDate(entry.lastCommit.committer.time)}>{timeAgo(entry.lastCommit.committer.time)}</time>
                  </>
                ) : null}
              </li>
            );
          })}
        </ul>
      </section>

      {tree.readme && readmeHtml ? (
        <section class="mt-4 overflow-hidden rounded-lg border bg-background" aria-label={tree.readme.path}>
          <div class="flex items-center gap-2 border-b px-4 py-2.5 text-sm font-medium">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 text-muted-foreground"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 7H20v13H6.5A2.5 2.5 0 0 0 4 22V4.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {tree.readme.path.slice(tree.readme.path.lastIndexOf("/") + 1)}
          </div>
          <div class="px-4 py-5 sm:px-6"><div class="markdown" set:html={readmeHtml}></div></div>
        </section>
      ) : null}
    </div>

    <aside class="flex flex-col gap-4">
      <section class="overflow-hidden rounded-lg border bg-background" aria-label="Latest commits">
        <div class="flex items-center justify-between border-b px-4 py-2.5 text-sm"><a href={commitsUrl} class="font-medium hover:underline">Commits</a></div>
        <div data-commit-list data-url={apiCommitsUrl} class="divide-y" aria-busy="true" aria-label="Loading">
          {Array.from({ length: 3 }).map(() => <div class="flex items-center gap-4 px-4 py-2.5"><span class="h-4 w-40 animate-pulse rounded-md bg-muted"></span><span class="ml-auto h-4 w-16 animate-pulse rounded-md bg-muted"></span></div>)}
        </div>
      </section>
      {sections.map((section) => (
        <section class="overflow-hidden rounded-lg border bg-background" aria-label={section.title}>
          <div class="flex items-center gap-2 border-b px-4 py-2.5 text-sm">
            <a href={`${repoUrl(repo)}/${section.title.toLowerCase()}`} class="font-medium hover:underline">{section.title}</a>
            <span class="rounded-full bg-muted px-1.5 text-xs tabular-nums">{section.items.length}</span>
          </div>
          <ul class="divide-y text-sm">
            {section.items.slice(0, 3).map((item) => (
              <li class="flex items-center gap-2 px-4 py-2">
                <a href={treeUrl(repo, "", item.name)} class="min-w-0 truncate hover:underline">{item.name}</a>
                {section.title === "Branches" && item.name === refs.defaultBranch ? <span class="rounded-md border px-1.5 text-xs text-muted-foreground">default</span> : null}
                <time class="ml-auto shrink-0 text-xs text-muted-foreground" datetime={new Date(item.commit.committer.time * 1000).toISOString()} title={fullDate(item.commit.committer.time)}>{timeAgo(item.commit.committer.time)}</time>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </aside>
  </div>
</main>

<script is:inline>
  const commitList = document.querySelector("[data-commit-list]");
  if (commitList instanceof HTMLElement && commitList.dataset.url) {
    const ago = (seconds) => {
      const delta = seconds - Math.round(Date.now() / 1000);
      const units = [["year", 31536000], ["month", 2592000], ["week", 604800], ["day", 86400], ["hour", 3600], ["minute", 60]];
      for (const [unit, size] of units) if (Math.abs(delta) >= size) return new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(Math.trunc(delta / size), unit);
      return "just now";
    };
    const load = async () => {
      try {
        const response = await fetch(commitList.dataset.url, { headers: { Accept: "application/json" } });
        if (!response.ok) return;
        const { commits } = await response.json();
        commitList.replaceChildren(...commits.slice(0, 3).map((commit) => {
          const row = document.createElement("div");
          row.className = "flex items-start gap-3 px-4 py-3";
          const body = document.createElement("div"); body.className = "min-w-0 flex-1";
          const subject = document.createElement("a"); subject.href = commit.url; subject.className = "line-clamp-2 font-medium hover:underline"; subject.textContent = commit.subject || "(no message)";
          const meta = document.createElement("p"); meta.className = "mt-0.5 text-xs text-muted-foreground"; meta.textContent = `${commit.author.name} committed ${ago(commit.committer.time)}`;
          body.append(subject, meta);
          const oid = document.createElement("a"); oid.href = commit.url; oid.className = "shrink-0 rounded-md border px-1.5 py-0.5 font-mono text-xs text-muted-foreground hover:bg-muted hover:text-foreground"; oid.textContent = commit.oid.slice(0, 7);
          row.append(body, oid); return row;
        }));
        commitList.setAttribute("aria-busy", "false");
      } catch {}
    };
    if ("requestIdleCallback" in window) window.requestIdleCallback(load, { timeout: 1500 }); else setTimeout(load, 0);
  }
</script>
