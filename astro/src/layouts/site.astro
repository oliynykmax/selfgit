---
import "../../../web/src/index.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" href="https://git.oliinyk.dev/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.classList.add("dark");
      } catch {
        // Storage is blocked, so the page keeps the system theme.
      }
    </script>
  </head>
  <body>
    <header class="border-b bg-background">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5">
            <circle cx="6" cy="6" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="6" cy="18" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="18" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M6 8.5v7M18 11.5c0 4-6 3-11 5" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          git.oliinyk.dev
        </a>
        <div class="ml-auto flex items-center gap-2">
          <button
            type="button"
            data-theme-toggle
            class="group/button inline-flex h-7 shrink-0 cursor-pointer items-center justify-center rounded-md border border-transparent bg-clip-padding px-2.5 text-[0.8rem] font-medium outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
            aria-label="Dark theme"
            aria-pressed="false"
          >
            <svg data-theme-icon="moon" viewBox="0 0 24 24" aria-hidden="true" class="size-3.5">
              <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <a
            href="https://git.oliinyk.dev/auth/github/login"
            class="group/button inline-flex h-7 shrink-0 cursor-pointer items-center justify-center rounded-md border border-border bg-background bg-clip-padding px-2.5 text-[0.8rem] font-medium outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
          >
            Sign in
          </a>
        </div>
      </div>
    </header>
    <slot />
    <script is:inline>
      const toggle = document.querySelector("[data-theme-toggle]");
      const setThemeButton = () => {
        const dark = document.documentElement.classList.contains("dark");
        toggle?.setAttribute("aria-pressed", String(dark));
      };
      setThemeButton();
      toggle?.addEventListener("click", () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
        setThemeButton();
      });
    </script>
  </body>
</html>
