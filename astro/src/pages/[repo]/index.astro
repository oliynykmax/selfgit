---
import TreePage from "../../components/tree-page.astro";
import Site from "../../layouts/site.astro";
import { viewFor } from "../../lib/selfgit";

const repo = Astro.params.repo ?? "";
const ref = Astro.url.searchParams.get("ref") ?? "HEAD";
const { tree, refs, duration: originDuration } = await viewFor(repo, "", ref);
Astro.response.headers.set(
  "Server-Timing",
  `selfgit-tree;dur=${originDuration.toFixed(1)}`,
);
---

<Site title={`${repo} · git.oliinyk.dev`}>
  <TreePage
    repo={repo}
    path=""
    ref={ref}
    refs={refs}
    tree={tree}
    originDuration={originDuration}
  />
</Site>
