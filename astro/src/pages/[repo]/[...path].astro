---
import TreePage from "../../components/tree-page.astro";
import { treeFor } from "../../lib/selfgit";

const repo = Astro.params.repo ?? "";
const path = Astro.params.path ?? "";
const { tree, duration: originDuration } = await treeFor(repo, path);
Astro.response.headers.set(
  "Server-Timing",
  `selfgit-tree;dur=${originDuration.toFixed(1)}`,
);
---

<TreePage repo={repo} path={path} tree={tree} originDuration={originDuration} />
