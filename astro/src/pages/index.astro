---
import Site from "../layouts/site.astro";
---

<Site title="git.oliinyk.dev">
  <main class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold tracking-tight">Repositories</h1>
    </div>
    <div class="mt-5 overflow-hidden rounded-lg border">
      <ul class="divide-y">
        <li>
          <a href="/selfgit" class="flex flex-col gap-1 px-4 py-3 hover:bg-muted/50 sm:flex-row sm:items-center sm:gap-4">
            <span class="w-24 shrink-0 font-medium">selfgit</span>
            <span class="min-w-0 flex-1 truncate text-sm text-muted-foreground">A small, personal Git server that runs entirely on Cloudflare Workers.</span>
          </a>
        </li>
      </ul>
    </div>
  </main>
</Site>
