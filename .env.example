# Deploy settings. Locally, export these before `bun run deploy`. In GitHub Actions they
# live in the "production" environment (see .github/workflows/deploy.yml).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Your numeric GitHub id (`gh api user --jq .id`). Only this account can push.
GITHUB_OWNER_ID=
# Optional custom domain for the selfgit-astro front end. Leave empty to use workers.dev.
DEPLOY_DOMAIN=

# Worker secrets for web sign-in (set with `bunx wrangler secret put NAME`):
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
