{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selfgit",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "git.oliinyk.dev", "custom_domain": true }],
  "vars": { "GITHUB_OWNER_ID": "85843900" },
  "secrets": {
    "required": ["GITHUB_OAUTH_CLIENT_ID", "GITHUB_OAUTH_CLIENT_SECRET"],
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "selfgit-objects" }],
  "durable_objects": {
    "bindings": [
      { "name": "REPOS", "class_name": "Repository" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "SESSIONS", "class_name": "Sessions" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Repository"] },
    { "tag": "v2", "new_sqlite_classes": ["Sessions"] },
    { "tag": "v3", "new_sqlite_classes": ["Registry"] },
  ],
}
